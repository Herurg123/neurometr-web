{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neurometr:schema:catalog-manifest:0.1.0",
  "title": "Neurometr immutable catalog manifest v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "neurometr.catalog-manifest"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"
    },
    "catalog_schema_version": {
      "const": "0.1.0"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
    },
    "compatible_diagnostic_schema_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
      }
    },
    "min_agent_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "signing_key_id": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/data/catalog/versions/[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*/catalog\\.json$"
          },
          "media_type": {
            "const": "application/json"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20971520
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "media_type",
          "bytes",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "kind",
    "schema_version",
    "catalog_version",
    "catalog_schema_version",
    "published_at",
    "compatible_diagnostic_schema_versions",
    "min_agent_version",
    "signing_key_id",
    "artifacts"
  ]
}
