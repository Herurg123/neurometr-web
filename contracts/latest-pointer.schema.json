{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neurometr:schema:catalog-pointer:0.1.0",
  "title": "Neurometr untrusted latest.json pointer v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "neurometr.catalog-pointer"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "manifest_path": {
      "type": "string",
      "pattern": "^/data/catalog/manifests/[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*/manifest\\.json$"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "manifest_path"
  ]
}
